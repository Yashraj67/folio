# Copy to .env and edit. docker compose reads this automatically.

# Public hostname for HTTPS (e.g. a free DuckDNS subdomain pointing at your VM)
FOLIO_DOMAIN=yourname.duckdns.org

# Postgres password (pick something long and random)
FOLIO_DB_PASSWORD=change-me-to-something-long

# 1 = session cookies require HTTPS (keep 1 in production behind Caddy)
FOLIO_COOKIE_SECURE=1

# 1 = anyone can register; set 0 after your users have created accounts
FOLIO_REGISTRATION_OPEN=1
